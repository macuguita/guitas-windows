{
  "schemaVersion": 1,
  "id": "windows",
  "version": "${version}",
  "name": "guita's Windows",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "Me!"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/windows/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "com.macuguita.windows.fabric.WindowsDataGenerator"
    ],
    "main": [
      "com.macuguita.windows.fabric.WindowsFabric"
    ],
    "client": [
      "com.macuguita.windows.fabric.client.WindowsFabricClient"
    ]
  },
  "mixins": [
    "windows.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "macu_lib": ">=${macu_lib}-1.20.1",
    "fabric-api": "*"
  },
  "suggests": {
    "another-mod": "*"
  }
}
